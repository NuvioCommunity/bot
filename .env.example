# Discord bot token (from Discord Developer Portal → Bot tab)
DISCORD_TOKEN=your_discord_bot_token_here

# GitHub personal access token (needs Issues: Read & Write on the target repos)
GITHUB_TOKEN=your_github_pat_here

# Forum IDs, server ID, and repo/tag routing are hardcoded in src/config.ts presets.

# Optional cap for OP self-replies before comment sync stops.
# Leave unset for unlimited replies.
# MAX_SELF_REPLIES=25

# How often to poll GitHub for new comments to mirror to Discord (milliseconds)
GITHUB_REPLY_POLL_MS=30000

# How often to poll GitHub for issue create/close lifecycle sync (milliseconds)
GITHUB_ISSUE_POLL_MS=20000
